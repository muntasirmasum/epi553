```{=html}
<ul class="lecture-grid list">
<% for (const item of items) { %>
  <li <%= metadataAttrs(item) %>>
    <article class="lecture-card">
      <span class="eyebrow">Lecture <%= String(item.lecture).padStart(2, "0") %> · <span class="lecture-unit"><%= item.unit %></span></span>
      <h2 class="listing-title"><a href="<%- item.path %>" class="stretched-link"><%= item.title %></a></h2>
      <p class="listing-description"><%= item.description %></p>
    </article>
  </li>
<% } %>
</ul>
```
